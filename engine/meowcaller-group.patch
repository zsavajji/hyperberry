+func TestIsEndedOffer(t *testing.T) {
+	for attrs, want := range map[string]bool{"": false, "is_call_ended": true, "terminate_reason": true} {
+		n := &waBinary.Node{Tag: "offer", Attrs: waBinary.Attrs{}}
+		if attrs == "is_call_ended" {
+			n.Attrs[attrs] = "1"
+		} else if attrs != "" {
+			n.Attrs[attrs] = "accepted_elsewhere"
+		}
+		if got := isEndedOffer(n); got != want {
+			t.Fatalf("%q: got %v", attrs, got)
+		}
+	}
+}
