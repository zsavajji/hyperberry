+func TestReachableTargetsDropsUsersDiscoveryLeftOut(t *testing.T) {
+	a, b, c := types.NewJID("1", "lid"), types.NewJID("2", "lid"), types.NewJID("3", "lid")
+	got, err := reachableTargets([]types.JID{a, b, c}, []signaling.GroupCallParticipant{{JID: a}, {JID: c}})
+	if err != nil || len(got) != 2 || got[0] != a || got[1] != c {
+		t.Fatalf("got %v, %v", got, err)
+	}
+	if _, err = reachableTargets([]types.JID{a, b, c}, []signaling.GroupCallParticipant{{JID: a}}); err == nil {
+		t.Fatal("one reachable target left must fail")
+	}
+}
+
+func TestIsEndedOffer(t *testing.T) {
+	for attrs, want := range map[string]bool{"": false, "is_call_ended": true, "terminate_reason": true} {
+		n := &waBinary.Node{Tag: "offer", Attrs: waBinary.Attrs{}}
+		if attrs == "is_call_ended" {
+			n.Attrs[attrs] = "1"
+		} else if attrs != "" {
+			n.Attrs[attrs] = "accepted_elsewhere"
+		}
+		if got := isEndedOffer(n); got != want {
+			t.Fatalf("%q: got %v", attrs, got)
+		}
+	}
+}
