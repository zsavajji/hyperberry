+// reachableTargets is selected without the users discovery left out (hyperberry patch). Fewer than
+// two remote targets left is the same error as asking for fewer than two.
+func reachableTargets(selected []types.JID, participants []signaling.GroupCallParticipant) ([]types.JID, error) {
+	kept := make(map[types.JID]struct{}, len(participants))
+	for _, p := range participants {
+		kept[p.JID.ToNonAD()] = struct{}{}
+	}
+	out := make([]types.JID, 0, len(selected))
+	for _, t := range selected {
+		if _, ok := kept[t]; ok {
+			out = append(out, t)
+		}
+	}
+	if len(out) < 2 {
+		return nil, errors.New("meowcaller: group call requires at least two reachable remote targets")
+	}
+	return out, nil
+}
