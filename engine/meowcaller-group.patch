+package meowcaller
+
+import "testing"
+
+// A queue that runs out mid-speech holds a frame more; one that runs out after silence doesn't.
+func TestHyperberryMixTarget(t *testing.T) {
+	m := newParticipantAudioMixer()
+	tone := make([]float32, 3*FrameSamples)
+	for i := range tone {
+		tone[i] = 0.1
+	}
+	drain := func() {
+		for i := 0; i < 400; i++ {
+			m.MixChunk()
+		}
+	}
+	m.Add("a", tone)
+	drain()
+	if got := m.streams["a"].target; got != 4*FrameSamples {
+		t.Fatalf("after speech ran out: target %d, want %d", got, 4*FrameSamples)
+	}
+	m.Add("a", make([]float32, 4*FrameSamples))
+	drain()
+	if got := m.streams["a"].target; got != 4*FrameSamples {
+		t.Fatalf("after silence ran out: target %d, want %d", got, 4*FrameSamples)
+	}
+	for i := 0; i < 5; i++ {
+		m.Add("a", tone)
+		m.Add("a", tone[:FrameSamples])
+		drain()
+	}
+	if got := m.streams["a"].target; got != participantAudioMixerMaxTarget {
+		t.Fatalf("target %d, want the cap %d", got, participantAudioMixerMaxTarget)
+	}
+}
