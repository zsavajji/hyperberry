+package meowcaller
+
+import (
+	"testing"
+
+	waBinary "github.com/polymorfa/hypermeow/binary"
+	"github.com/polymorfa/hypermeow/types"
+)
+
+// A queue that runs out mid-speech holds a frame more; one that runs out after silence doesn't.
+func TestHyperberryMixTarget(t *testing.T) {
+	m := newParticipantAudioMixer()
+	tone := make([]float32, 3*FrameSamples)
+	for i := range tone {
+		tone[i] = 0.1
+	}
+	drain := func() {
+		for i := 0; i < 400; i++ {
+			m.MixChunk()
+		}
+	}
+	m.Add("a", tone)
+	drain()
+	if got := m.streams["a"].target; got != 4*FrameSamples {
+		t.Fatalf("after speech ran out: target %d, want %d", got, 4*FrameSamples)
+	}
+	m.Add("a", make([]float32, 4*FrameSamples))
+	drain()
+	if got := m.streams["a"].target; got != 4*FrameSamples {
+		t.Fatalf("after silence ran out: target %d, want %d", got, 4*FrameSamples)
+	}
+	for i := 0; i < 5; i++ {
+		m.Add("a", tone)
+		m.Add("a", tone[:FrameSamples])
+		drain()
+	}
+	if got := m.streams["a"].target; got != participantAudioMixerMaxTarget {
+		t.Fatalf("target %d, want the cap %d", got, participantAudioMixerMaxTarget)
+	}
+}
+
+// A group offer's ack with error 207 (a device missed, 427) is the group's first roster, not a refusal.
+func TestHyperberryGroupAck207(t *testing.T) {
+	eng, call, creator := testGroupEngine("GROUP")
+	eng.calls["GROUP"].direction = CallDirectionOutgoing
+	participant := types.NewJID("200", types.HiddenUserServer)
+	ack := &waBinary.Node{
+		Tag:   "ack",
+		Attrs: waBinary.Attrs{"class": "call", "type": "offer", "id": "REQUEST", "error": "207"},
+		Content: []waBinary.Node{{
+			Tag: "group_info",
+			Attrs: waBinary.Attrs{
+				"call-id": "GROUP", "call-creator": creator,
+				"transaction-id": "6", "connected-limit": "32", "media": "audio", "joinable": "1",
+			},
+			Content: []waBinary.Node{{
+				Tag:   "user",
+				Attrs: waBinary.Attrs{"jid": participant, "state": "outgoing"},
+				Content: []waBinary.Node{
+					{Tag: "device", Attrs: waBinary.Attrs{"jid": types.NewADJID("200", 0, 0)}},
+					{Tag: "device", Attrs: waBinary.Attrs{"jid": types.NewADJID("200", 0, 46), "error": "427"}},
+				},
+			}},
+		}},
+	}
+	eng.onCallAck(ack)
+	state, ok := call.GroupState()
+	if !ok || state.TransactionID != 6 || len(state.Participants) != 1 {
+		t.Fatalf("group state = %#v, present=%v", state, ok)
+	}
+	if eng.calls["GROUP"] == nil {
+		t.Fatal("the call ended on a 207")
+	}
+}
+
+// A keyframe request goes to the media's PLI sender with the SSRC asked, and fails with no media.
+func TestHyperberryRequestParticipantKeyframe(t *testing.T) {
+	eng, call, _ := testGroupEngine("GROUP")
+	if err := call.RequestParticipantKeyframe(7); err == nil {
+		t.Fatal("a keyframe request with no media running succeeded")
+	}
+	var got uint32
+	eng.calls["GROUP"].keyframe = func(ssrc uint32) error { got = ssrc; return nil }
+	if err := call.RequestParticipantKeyframe(7); err != nil || got != 7 {
+		t.Fatalf("keyframe request: err %v, ssrc %d", err, got)
+	}
+}
