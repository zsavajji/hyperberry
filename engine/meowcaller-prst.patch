+// ParsePrst finds the bandwidth allowance (bit/s) in a compound RTCP packet: a PSFB (PT 206) FMT 15
+// packet named "PRST" at offset 12, then a 2-byte length and the protobuf BuildPrst writes,
+// {1: {1: bit/s}, 4: 1}. Android sends one about every 5 s. ok is false when there is none, or
+// when what is there is cut short or not shaped like that.
+func ParsePrst(compound []byte) (uint32, bool) {
+	for off := 0; off+4 <= len(compound); {
+		n := (int(binary.BigEndian.Uint16(compound[off+2:])) + 1) * 4
+		if off+n > len(compound) {
+			break
+		}
+		p := compound[off : off+n]
+		off += n
+		if p[1] != RtcpPtPsfb || p[0]&0x1f != 15 || len(p) < 18 || string(p[12:16]) != "PRST" {
+			continue
+		}
+		body := p[18:]
+		if size := int(binary.BigEndian.Uint16(p[16:])); size <= len(body) {
+			if bps, ok := prstAllowance(body[:size]); ok {
+				return bps, true
+			}
+		}
+	}
+	return 0, false
+}
+
+// prstAllowance reads field 1's field 1 (a varint) out of the protobuf, skipping the fields it
+// doesn't know.
+func prstAllowance(pb []byte) (uint32, bool) {
+	for len(pb) > 0 {
+		num, wire, v, data, rest, ok := pbField(pb)
+		if !ok {
+			return 0, false
+		}
+		pb = rest
+		if num != 1 || wire != 2 {
+			continue
+		}
+		for len(data) > 0 {
+			num, wire, v, _, rest, ok = pbField(data)
+			if !ok {
+				return 0, false
+			}
+			data = rest
+			if num == 1 && wire == 0 && v <= 1<<32-1 {
+				return uint32(v), true
+			}
+		}
+	}
+	return 0, false
+}
+
+// pbField reads the protobuf field at the start of b: its number and wire type, its value (a
+// varint, wire type 0) or its bytes (wire type 2), and what follows. Fixed-size fields (wire types
+// 1 and 5) are stepped over; anything else, or anything cut short, is not ok.
+func pbField(b []byte) (num uint64, wire byte, v uint64, data, rest []byte, ok bool) {
+	key, n := binary.Uvarint(b)
+	if n <= 0 {
+		return
+	}
+	b = b[n:]
+	num, wire = key>>3, byte(key&7)
+	switch wire {
+	case 0:
+		if v, n = binary.Uvarint(b); n > 0 {
+			return num, wire, v, nil, b[n:], true
+		}
+	case 2:
+		size, n := binary.Uvarint(b)
+		if n > 0 && size <= uint64(len(b)-n) {
+			return num, wire, 0, b[n : n+int(size)], b[n+int(size):], true
+		}
+	case 1, 5:
+		size := 8
+		if wire == 5 {
+			size = 4
+		}
+		if size <= len(b) {
+			return num, wire, 0, nil, b[size:], true
+		}
+	}
+	return
+}
