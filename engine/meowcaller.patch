+package rtp
+
+import (
+	"encoding/hex"
+	"testing"
+)
+
+// The two allowances Android sent on 2026-11-08, byte for byte.
+func TestBuildPrstMatchesAndroid(t *testing.T) {
+	for bps, want := range map[uint32]string{
+		35000: "8fce0006618e67cc000000005052535400080a0408b8910220010000",
+		57458: "8fce0006618e67cc000000005052535400080a0408f2c00320010000",
+	} {
+		if got := hex.EncodeToString(BuildPrst(0x618e67cc, bps)); got != want {
+			t.Errorf("%d: %s, want %s", bps, got, want)
+		}
+	}
+	if p := BuildPrst(1, 1_000_000); len(p)%4 != 0 || int(p[3]+1)*4 != len(p) {
+		t.Errorf("1 Mbit/s: % x", p)
+	}
+}
