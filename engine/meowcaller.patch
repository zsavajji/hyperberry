+package rtp
+
+import "encoding/binary"
+
+// BuildPrst builds the bandwidth allowance a WhatsApp client sends its peer, as read off Android's
+// packets (hyperberry, 2026-11-08; no library documents it): PSFB (PT 206) FMT 15 with the name
+// "PRST", from the sender's audio SSRC, media SSRC 0, then a 2-byte length and a protobuf
+// {1: {1: bit/s}, 4: 1}, zero-padded to a word. Android sent 35000-57458 while we sent it ~13 kbit/s
+// of audio: an allowance above what it received, so presumably what the peer may send.
+func BuildPrst(senderSSRC, bps uint32) []byte {
+	inner := binary.AppendUvarint([]byte{0x08}, uint64(bps))
+	pb := append([]byte{0x0a, byte(len(inner))}, inner...)
+	pb = append(pb, 0x20, 0x01)
+	out := []byte{0x8f, 206, 0, 0}
+	out = binary.BigEndian.AppendUint32(out, senderSSRC)
+	out = binary.BigEndian.AppendUint32(out, 0)
+	out = append(out, 'P', 'R', 'S', 'T')
+	out = binary.BigEndian.AppendUint16(out, uint16(len(pb)))
+	out = append(out, pb...)
+	for len(out)%4 != 0 {
+		out = append(out, 0)
+	}
+	binary.BigEndian.PutUint16(out[2:4], uint16(len(out)/4-1))
+	return out
+}
