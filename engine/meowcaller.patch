+// hyperberry: a bandwidth estimate is kept whole once, a plain SR (no report blocks) isn't.
+func TestRtcpCensusKeepsSamples(t *testing.T) {
+	var c RtcpCensus
+	remb := []byte{0x8f, 206, 0, 2, 1, 2, 3, 4, 0, 0, 0, 0}
+	sr := []byte{0x80, 200, 0, 1, 9, 9, 9, 9}
+	for i := 0; i < 5; i++ {
+		c.Add(append(append([]byte{}, sr...), remb...))
+	}
+	got := c.TakeSamples()
+	if len(got) != 3 || got[0] != "PSFB-APP(REMB?) 8fce000201020304"+"00000000" {
+		t.Fatalf("samples: %q", got)
+	}
+	if more := c.TakeSamples(); len(more) != 0 {
+		t.Fatalf("taken twice: %q", more)
+	}
+}
