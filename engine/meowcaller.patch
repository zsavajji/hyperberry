+// prstAllowance is the bandwidth allowance sent to the peer, in bit/s (hyperberry).
+const prstAllowance = 1_000_000
+
+// prst protects a bandwidth allowance (rtp.BuildPrst) from this sender's SSRC (hyperberry).
+func (s *mediaSrtcpSender) prst(bps uint32) ([]byte, error) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	packet, err := srtp.ProtectSrtcp(&s.keys, s.ssrc, s.index, rtp.BuildPrst(s.ssrc, bps))
+	if err == nil {
+		s.index++
+	}
+	return packet, err
 }
 
