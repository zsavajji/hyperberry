+// HyperBerry: fftRec's twiddles, computed once per length and direction with the very float32
+// expressions it used to evaluate on every call, so the output is bit-identical. Recomputing
+// them took 45 of the 77 s that encoding a minute of audio cost on the Q10 (2026-11-07), mostly
+// math.Cos and math.Sin's float64 to uint64 conversion, which 32-bit ARM does in software. The
+// encoder's lengths, 512 and 576, factor into 2s and 3s, so the tables are a few KB in all.
+type twiddleKey struct {
+	n    int
+	sign float32
+}
+
+var twiddles sync.Map // twiddleKey -> []cpx
+
+// twiddleTable is [k*n+j] for a prime n (p == n), else [k*p+q].
+func twiddleTable(n, p int, sign float32) []cpx {
+	key := twiddleKey{n, sign}
+	if t, ok := twiddles.Load(key); ok {
+		return t.([]cpx)
+	}
+	w := func(ang float32) cpx {
+		return cpx{re: float32(math.Cos(float64(ang))), im: float32(math.Sin(float64(ang)))}
+	}
+	var t []cpx
+	if p == n {
+		t = make([]cpx, n*n)
+		for k := 0; k < n; k++ {
+			angK := sign * 2.0 * smplPI * float32(k) / float32(n)
+			for j := 0; j < n; j++ {
+				t[k*n+j] = w(angK * float32(j))
+			}
+		}
+	} else {
+		t = make([]cpx, n*p)
+		for k := 0; k < n; k++ {
+			for q := 0; q < p; q++ {
+				t[k*p+q] = w(sign * 2.0 * smplPI * float32(k) * float32(q) / float32(n))
+			}
+		}
+	}
+	twiddles.Store(key, t)
+	return t
+}
+
