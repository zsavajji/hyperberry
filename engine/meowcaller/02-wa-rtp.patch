--- a/rtp/reorder.go	1970-01-01 01:00:00
+++ b/rtp/reorder.go	2026-11-07 21:51:36
@@ -0,0 +1,98 @@
+package rtp
+
+import "time"
+
+// wa-poc patch: SeqReorderBuffer puts RTP packets back into sequence order before they reach
+// H264AccessUnitAssembler, which treats any out-of-order packet as loss and then discards
+// every frame until the next IDR. Packets are held briefly; a missing sequence number is
+// declared lost only when the buffer grows past MaxPending or has waited MaxWait.
+
+// OrderedPacket is one RTP payload released in sequence order.
+type OrderedPacket struct {
+	Seq     uint16
+	Marker  bool
+	Payload []byte
+}
+
+// SeqReorderBuffer is a small RTP reorder stage. The zero value is ready to use.
+type SeqReorderBuffer struct {
+	next      uint16
+	started   bool
+	pending   map[uint16]OrderedPacket
+	waitSince time.Time
+
+	// Stats (cumulative).
+	Late    uint64 // arrived after their slot was released or skipped: dropped
+	Skipped uint64 // sequence numbers given up on as lost
+	Held    uint64 // packets that had to wait for an earlier one
+}
+
+const (
+	// Measured: at 80 ms many packets still arrived "late" once the peer ramped up its bitrate.
+	reorderMaxPending = 96
+	reorderMaxWait    = 200 * time.Millisecond
+)
+
+// Push accepts one packet and returns the packets now releasable, in order.
+func (b *SeqReorderBuffer) Push(seq uint16, marker bool, payload []byte, now time.Time) []OrderedPacket {
+	if b.pending == nil {
+		b.pending = make(map[uint16]OrderedPacket)
+	}
+	if !b.started {
+		b.started = true
+		b.next = seq
+	}
+	if int16(seq-b.next) < 0 {
+		b.Late++
+		return nil
+	}
+	if _, dup := b.pending[seq]; dup {
+		return nil
+	}
+	p := make([]byte, len(payload))
+	copy(p, payload)
+	b.pending[seq] = OrderedPacket{Seq: seq, Marker: marker, Payload: p}
+	if seq != b.next {
+		b.Held++
+	}
+
+	out := b.drain(nil)
+	if len(b.pending) == 0 {
+		b.waitSince = time.Time{}
+		return out
+	}
+	if b.waitSince.IsZero() {
+		b.waitSince = now
+	}
+	if len(b.pending) > reorderMaxPending || now.Sub(b.waitSince) > reorderMaxWait {
+		// Give up on the gap: jump to the oldest packet we do have.
+		oldest := b.next
+		first := true
+		for s := range b.pending {
+			if first || int16(s-oldest) < 0 {
+				oldest, first = s, false
+			}
+		}
+		b.Skipped += uint64(uint16(oldest - b.next))
+		b.next = oldest
+		out = b.drain(out)
+		if len(b.pending) == 0 {
+			b.waitSince = time.Time{}
+		} else {
+			b.waitSince = now
+		}
+	}
+	return out
+}
+
+func (b *SeqReorderBuffer) drain(out []OrderedPacket) []OrderedPacket {
+	for {
+		p, ok := b.pending[b.next]
+		if !ok {
+			return out
+		}
+		delete(b.pending, b.next)
+		out = append(out, p)
+		b.next++
+	}
+}
--- a/rtp/reorder_test.go	1970-01-01 01:00:00
+++ b/rtp/reorder_test.go	2026-11-07 21:51:36
@@ -0,0 +1,46 @@
+package rtp
+
+import (
+	"testing"
+	"time"
+)
+
+func seqs(ps []OrderedPacket) []uint16 {
+	out := make([]uint16, len(ps))
+	for i, p := range ps {
+		out[i] = p.Seq
+	}
+	return out
+}
+
+func TestReorderBufferReorders(t *testing.T) {
+	var b SeqReorderBuffer
+	now := time.Now()
+	if got := seqs(b.Push(10, false, []byte{1}, now)); len(got) != 1 || got[0] != 10 {
+		t.Fatalf("first: %v", got)
+	}
+	if got := b.Push(12, false, []byte{1}, now); len(got) != 0 {
+		t.Fatalf("12 should wait for 11: %v", seqs(got))
+	}
+	got := seqs(b.Push(11, true, []byte{1}, now))
+	if len(got) != 2 || got[0] != 11 || got[1] != 12 {
+		t.Fatalf("want [11 12], got %v", got)
+	}
+	if b.Skipped != 0 || b.Late != 0 {
+		t.Fatalf("no loss expected: %+v", b)
+	}
+}
+
+func TestReorderBufferSkipsLossAfterWait(t *testing.T) {
+	var b SeqReorderBuffer
+	now := time.Now()
+	b.Push(65534, false, []byte{1}, now) // wraps
+	b.Push(0, false, []byte{1}, now)     // 65535 missing
+	got := seqs(b.Push(1, false, []byte{1}, now.Add(250*time.Millisecond)))
+	if len(got) != 2 || got[0] != 0 || got[1] != 1 || b.Skipped != 1 {
+		t.Fatalf("want skip 65535 then [0 1], got %v skipped=%d", got, b.Skipped)
+	}
+	if late := b.Push(65535, false, []byte{1}, now); late != nil || b.Late != 1 {
+		t.Fatalf("late packet should be dropped")
+	}
+}
--- a/rtp/rtcp_census.go	1970-01-01 01:00:00
+++ b/rtp/rtcp_census.go	2026-11-07 21:51:36
@@ -0,0 +1,106 @@
+package rtp
+
+import (
+	"encoding/binary"
+	"fmt"
+	"sort"
+	"strings"
+)
+
+// wa-poc patch: RtcpCensus counts the RTCP packet types a peer sends (by PT and FMT), so we
+// can see what feedback a real WhatsApp client expects the sender to act on: NACK
+// (RTPFB/1), transport-wide CC (RTPFB/15), PLI (PSFB/1), FIR (PSFB/4), REMB/app (PSFB/15).
+type RtcpCensus struct {
+	counts      map[string]int
+	NackedSeqs  int // sequence numbers asked for retransmission
+	nackSamples []string
+}
+
+func rtcpName(pt, fmtv uint8) string {
+	switch pt {
+	case 200:
+		return "SR"
+	case 201:
+		return "RR"
+	case 202:
+		return "SDES"
+	case 203:
+		return "BYE"
+	case 204:
+		return "APP"
+	case 205:
+		switch fmtv {
+		case 1:
+			return "NACK"
+		case 15:
+			return "TWCC"
+		}
+		return fmt.Sprintf("RTPFB/%d", fmtv)
+	case 206:
+		switch fmtv {
+		case 1:
+			return "PLI"
+		case 4:
+			return "FIR"
+		case 15:
+			return "PSFB-APP(REMB?)"
+		}
+		return fmt.Sprintf("PSFB/%d", fmtv)
+	}
+	return fmt.Sprintf("PT%d/%d", pt, fmtv)
+}
+
+// Add counts every packet in one (decrypted) compound RTCP packet.
+func (c *RtcpCensus) Add(compound []byte) {
+	if c.counts == nil {
+		c.counts = make(map[string]int)
+	}
+	for off := 0; off+4 <= len(compound); {
+		if (compound[off]>>6)&0x03 != 2 {
+			c.counts["?non-v2"]++
+			return
+		}
+		fmtv := compound[off] & 0x1f
+		pt := compound[off+1]
+		length := (int(binary.BigEndian.Uint16(compound[off+2:])) + 1) * 4
+		if length < 4 || off+length > len(compound) {
+			c.counts["?truncated"]++
+			return
+		}
+		name := rtcpName(pt, fmtv)
+		c.counts[name]++
+		if pt == 205 && fmtv == 1 && length >= 16 {
+			// Generic NACK FCI: PID (16) + BLP (16) bitmask of the following 16.
+			for fci := compound[off+12 : off+length]; len(fci) >= 4; fci = fci[4:] {
+				pid := binary.BigEndian.Uint16(fci)
+				blp := binary.BigEndian.Uint16(fci[2:])
+				n := 1
+				for b := blp; b != 0; b &= b - 1 {
+					n++
+				}
+				c.NackedSeqs += n
+				if len(c.nackSamples) < 5 {
+					c.nackSamples = append(c.nackSamples, fmt.Sprintf("%d+%04x", pid, blp))
+				}
+			}
+		}
+		off += length
+	}
+}
+
+// String summarises the counts, e.g. "NACK=3 RR=12 SR=12 TWCC=40".
+func (c *RtcpCensus) String() string {
+	keys := make([]string, 0, len(c.counts))
+	for k := range c.counts {
+		keys = append(keys, k)
+	}
+	sort.Strings(keys)
+	parts := make([]string, 0, len(keys)+1)
+	for _, k := range keys {
+		parts = append(parts, fmt.Sprintf("%s=%d", k, c.counts[k]))
+	}
+	if c.NackedSeqs > 0 {
+		parts = append(parts, fmt.Sprintf("nacked_seqs=%d e.g.%v", c.NackedSeqs, c.nackSamples))
+	}
+	return strings.Join(parts, " ")
+}
